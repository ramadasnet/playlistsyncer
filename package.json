{
    "name": "playlistsyncer",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "NITRO_PRESET=bun nuxt build",
        "check": "bun run typecheck && bun test",
        "dev": "nuxt dev --host 0.0.0.0 --port 3007",
        "jobs": "bun server/jobs/main.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "test": "bun test",
        "typecheck": "nuxt typecheck"
    },
    "dependencies": {
        "@pinia/nuxt": "^1.0.2",
        "anyhow": "^3.4.0",
        "creem": "^1.13.0",
        "lucide-vue-next": "^1.0.0",
        "mongodb": "^7.7.0",
        "nodemailer": "^10.0.13",
        "nuxt": "^4.5.2",
        "oauth4webapi": "^3.8.8",
        "pinia": "^4.0.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "@types/nodemailer": "^8.0.2",
        "prettier": "^3.9.9",
        "typescript": "6",
        "vue-tsc": "^3.3.11"
    },
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false,
        "arrowParens": "always",
        "bracketSpacing": false,
        "printWidth": 250
    }
}
