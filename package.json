{
    "name": "playlistsyncer",
    "version": "26.432.11718",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "NITRO_PRESET=bun nuxt build",
        "check": "bun run typecheck && bun test",
        "dev": "bun --preload ./server/preload.ts ./node_modules/.bin/nuxt dev --no-fork --host 0.0.0.0 --port 3007",
        "jobs": "bun --preload ./server/preload.ts server/jobs/main.ts",
        "start": "bun --preload ./server/preload.ts .output/server/index.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "test": "bun test",
        "typecheck": "nuxt typecheck"
    },
    "dependencies": {
        "@pinia/nuxt": "^1.0.3",
        "anyhow": "^3.4.0",
        "creem": "^1.13.0",
        "lucide-vue-next": "^1.0.0",
        "mongodb": "^7.7.0",
        "nodemailer": "^10.1.7",
        "nuxt": "^4.6.2",
        "oauth4webapi": "^3.8.8",
        "pinia": "^4.1.0",
        "pm2": "^7.0.4",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/nodemailer": "^8.0.2",
        "prettier": "^3.9.10",
        "typescript": "6",
        "vue-tsc": "^3.3.13"
    },
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false,
        "arrowParens": "always",
        "bracketSpacing": false,
        "printWidth": 250
    },
    "reviewAgents": {
        "draft": "@greptile",
        "ready": "@cubic"
    }
}
