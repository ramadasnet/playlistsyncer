# Exact externally visible origin, without a path
PLS_APP_URL=http://localhost:3007

# Public runtime configuration
PLS_APP_NAME=PlaylistSyncer
PLS_SUPPORT_EMAIL=info@playlistsyncer.com
PLS_CHATBASE_HELP_URL=https://www.chatbase.co/taNwdeaQwZIYPfxthXqRu/help

# Logging: human-readable locally; set true for JSON severity logs
PLS_JSON_LOGGING=false

# Optional: block all writes to music providers and log the changes that would be made
# PLS_SAFE_MODE=true

# Optional: enable Nuxt DevTools (off by default; the instrumentation is expensive)
# PLS_DEVTOOLS=true

# Application security
PLS_SESSION_SECRET=
PLS_TOKEN_ENCRYPTION_KEY=
PLS_SCHEDULER_SECRET=

# MongoDB
# In Cloud Agents, provide PLS_MONGODB_URI as an environment secret to use an external
# database (e.g. MongoDB Atlas); otherwise the local containerized MongoDB is used.
PLS_MONGODB_URI=mongodb://localhost:27017/playlistsync
PLS_MONGODB_DATABASE=playlistsync

# Optional SMTP for email confirmation (social registration without a provider email)
PLS_SMTP_HOST=
PLS_SMTP_PORT=587
PLS_SMTP_USER=
PLS_SMTP_PASSWORD=
PLS_SMTP_FROM=

# Development only: comma-separated users granted effective PRO access
PLS_DEVELOPMENT_PRO_USER_EMAILS=

# Instant after which PRO requires a paid subscription (ISO 8601).
# Before this instant, every account has complimentary PRO access.
# Leave empty to require a subscription immediately.
# PLS_PRO_SUBSCRIPTION_REQUIRED_AT=2027-01-01T00:00:00.000Z

# PRO automatic sync interval in minutes (default 720 = 12 hours)
# PLS_TASKSYNC_INTERVAL=720

# Spotify Web API
PLS_SPOTIFY_CLIENT_ID=
PLS_SPOTIFY_CLIENT_SECRET=

# Google OAuth and YouTube Data API v3
PLS_GOOGLE_CLIENT_ID=
PLS_GOOGLE_CLIENT_SECRET=

# Login with Amazon and approved Amazon Music partner API
PLS_AMAZON_CLIENT_ID=
PLS_AMAZON_CLIENT_SECRET=
PLS_AMAZON_MUSIC_API_BASE_URL=

# TIDAL Web API
PLS_TIDAL_CLIENT_ID=
PLS_TIDAL_CLIENT_SECRET=

# SoundCloud API (register an app; Artist Pro is required for app credentials)
PLS_SOUNDCLOUD_CLIENT_ID=
PLS_SOUNDCLOUD_CLIENT_SECRET=

# Optional: provider API requests per minute, shared by all accounts (0 disables pacing)
# PLS_SPOTIFY_MAX_REQUESTS_PER_MINUTE=120
# PLS_YOUTUBE_MAX_REQUESTS_PER_MINUTE=300
# PLS_TIDAL_MAX_REQUESTS_PER_MINUTE=60
# PLS_SOUNDCLOUD_MAX_REQUESTS_PER_MINUTE=60
# PLS_AMAZON_MAX_REQUESTS_PER_MINUTE=60

# Creem Billing
PLS_CREEM_API_KEY=
PLS_CREEM_PRO_PRODUCT_ID=
PLS_CREEM_WEBHOOK_SECRET=
PLS_CREEM_SERVER=test
