# Exact externally visible origin, without a path. Defaults to http://localhost:3007
# in development and https://playlistsyncer.com/ when NODE_ENV=production.
# PLS_APP_URL=https://playlistsyncer.com

# Scheduled jobs listen on their own process. Do not publish this port publicly.
# PLS_JOBS_PORT=3008

# Independent administration website (not included in the consumer build).
# PLS_ADMIN_URL=https://admin.playlistsyncer.com
# PLS_ADMIN_GOOGLE_CLIENT_ID=
# PLS_ADMIN_GOOGLE_CLIENT_SECRET=
# PLS_ADMIN_ALLOWED_EMAILS=igor@ramadas.net
# PLS_ADMIN_SESSION_HOURS=8

# Optional: load the remaining variables from Infisical at startup (Universal Auth machine identity).
# Variables that are already set here keep their value.
# PLS_INFISICAL_CLIENT_ID=
# PLS_INFISICAL_CLIENT_SECRET=
# PLS_INFISICAL_PROJECT_ID=
# PLS_INFISICAL_ENVIRONMENT=prod
# PLS_INFISICAL_SECRET_PATH=/
# PLS_INFISICAL_SITE_URL=https://app.infisical.com

# Public runtime configuration
PLS_APP_NAME=PlaylistSyncer
PLS_SUPPORT_EMAIL=info@playlistsyncer.com
PLS_CHATLAB_HELP_URL=https://api.chatlab.com/aichat/iframe?apiKey=e93d5608-6b9b-4d82-a414-927575080a94&iFrameMode=true&aichatbotProviderId=f9e9c5e4-6d1a-4b8c-8d3f-3f9e9c5e46d1

# Logging: human-readable plain text by default, set to true to save logs as JSON.
# PLS_JSON_LOGGING=true

# Optional: seconds a stopping process waits for in-flight sync runs before marking them failed.
# Keep it below PM2's kill grace (10 s in ecosystem.config.cjs).
# PLS_SHUTDOWN_TIMEOUT_SECONDS=8

# Production HTTP server (PM2 sets these for the website process; override here if needed)
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3007
# NITRO_BUN_IDLE_TIMEOUT=255

# Optional: block all writes to music providers and log the changes that would be made
# PLS_SAFE_MODE=true

# Optional: enable Nuxt DevTools (off by default; the instrumentation is expensive)
# PLS_DEVTOOLS=true

# Application security
PLS_SESSION_SECRET=
PLS_TOKEN_ENCRYPTION_KEY=
PLS_SCHEDULER_SECRET=

# MongoDB
# In Cloud Agents, provide PLS_MONGODB_URI as an environment secret to use an external
# database (e.g. MongoDB Atlas); otherwise the local containerized MongoDB is used.
# Firestore with MongoDB compatibility: set PLS_MONGODB_DATABASE to the database ID in the URI.
# The URI must include loadBalanced=true&tls=true&retryWrites=false. On a GCP VM, append
# &authMechanism=MONGODB-OIDC&authMechanismProperties=ENVIRONMENT:gcp,TOKEN_RESOURCE:FIRESTORE
PLS_MONGODB_URI=mongodb://localhost:27017/playlistsync
PLS_MONGODB_DATABASE=playlistsyncer

# SMTP for email confirmation and weekly summaries. Cloudflare is the default; set the
# password and sender address to enable delivery.
PLS_SMTP_HOST=smtp.mx.cloudflare.net
PLS_SMTP_PORT=465
PLS_SMTP_USER=api_token
PLS_SMTP_PASSWORD=
PLS_SMTP_FROM=

# Development only: comma-separated users granted effective PRO access
PLS_DEVELOPMENT_PRO_USER_EMAILS=

# Instant after which PRO requires a paid subscription (ISO 8601).
# Before this instant, every account has complimentary PRO access.
# Leave empty to require a subscription immediately.
# PLS_PRO_SUBSCRIPTION_REQUIRED_AT=2027-01-01T00:00:00.000Z

# PRO automatic sync interval in minutes (default 720 = 12 hours)
# PLS_TASKSYNC_INTERVAL=720

# Spotify Web API
PLS_SPOTIFY_CLIENT_ID=
PLS_SPOTIFY_CLIENT_SECRET=

# Google OAuth and YouTube Data API v3
PLS_GOOGLE_CLIENT_ID=
PLS_GOOGLE_CLIENT_SECRET=

# Login with Amazon and approved Amazon Music partner API
PLS_AMAZON_CLIENT_ID=
PLS_AMAZON_CLIENT_SECRET=
PLS_AMAZON_MUSIC_API_BASE_URL=

# TIDAL Web API
PLS_TIDAL_CLIENT_ID=
PLS_TIDAL_CLIENT_SECRET=

# SoundCloud API (register an app; Artist Pro is required for app credentials)
PLS_SOUNDCLOUD_CLIENT_ID=
PLS_SOUNDCLOUD_CLIENT_SECRET=

# Apple Music. One private key with both Sign in with Apple and Media Services (MusicKit) is enough.
# Set the MusicKit key too only when it is a different key. Apple Music stays hidden until the team, Services ID, and Sign in with Apple key are set.
# Private keys are the .p8 file contents; newlines may be written as \n.
PLS_APPLE_TEAM_ID=
PLS_APPLE_CLIENT_ID=
PLS_APPLE_SIGNIN_KEY_ID=
PLS_APPLE_SIGNIN_PRIVATE_KEY=
# Optional when the Sign in with Apple key also has Media Services enabled:
PLS_APPLE_MUSIC_KEY_ID=
PLS_APPLE_MUSIC_PRIVATE_KEY=

# Optional: provider API requests per minute, shared by all accounts (0 disables pacing; rate-limit cooldowns still apply)
# PLS_SPOTIFY_MAX_REQUESTS_PER_MINUTE=120
# PLS_YOUTUBE_MAX_REQUESTS_PER_MINUTE=300
# PLS_TIDAL_MAX_REQUESTS_PER_MINUTE=60
# PLS_SOUNDCLOUD_MAX_REQUESTS_PER_MINUTE=60
# PLS_APPLE_MAX_REQUESTS_PER_MINUTE=120
# PLS_AMAZON_MAX_REQUESTS_PER_MINUTE=60

# Optional: requests per minute one user can make to routes that call music providers (0 disables the limit)
# PLS_USER_PROVIDER_REQUESTS_PER_MINUTE=40

# Creem Billing: set all three or none
PLS_CREEM_API_KEY=
PLS_CREEM_PRO_PRODUCT_ID=
PLS_CREEM_WEBHOOK_SECRET=
# Defaults to prod when NODE_ENV=production and to test otherwise
# PLS_CREEM_SERVER=test
