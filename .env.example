# Exact externally visible origin, without a path
APP_URL=http://localhost:3007

# Public runtime configuration
NUXT_PUBLIC_APP_NAME=PlaylistSyncer
NUXT_PUBLIC_PRO_PRICE=Configured at checkout
NUXT_PUBLIC_SUPPORT_EMAIL=info@playlistsyncer.com
NUXT_PUBLIC_CHATBASE_HELP_URL=https://www.chatbase.co/taNwdeaQwZIYPfxthXqRu/help

# Logging: human-readable locally; set true for JSON severity logs
JSON_LOGGING=false

# Optional: enable Nuxt DevTools (off by default; the instrumentation is expensive)
# NUXT_DEVTOOLS=true

# Application security
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
SCHEDULER_SECRET=

# MongoDB
# In Cloud Agents, provide MONGODB_URI as an environment secret to use an external
# database (e.g. MongoDB Atlas); otherwise the local containerized MongoDB is used.
MONGODB_URI=mongodb://localhost:27017/playlistsync
MONGODB_DATABASE=playlistsync

# Optional SMTP for email confirmation (social registration without a provider email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Development only: comma-separated users granted effective PRO access
DEVELOPMENT_PRO_USER_EMAILS=

# Instant after which PRO requires a paid subscription (ISO 8601).
# Before this instant, every account has complimentary PRO access.
# Leave empty to require a subscription immediately.
# PRO_SUBSCRIPTION_REQUIRED_AT=2027-01-01T00:00:00.000Z

# PRO automatic sync interval in hours (default 12)
# PRO_SYNC_INTERVAL_HOURS=12

# Spotify Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google OAuth and YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login with Amazon and approved Amazon Music partner API
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_MUSIC_API_BASE_URL=

# TIDAL Web API
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Creem Billing
CREEM_API_KEY=
CREEM_PRO_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
CREEM_SERVER=test
