# Exact externally visible origin, without a path
APP_URL=http://localhost:3007

# Public runtime configuration
NUXT_PUBLIC_APP_NAME=PlaylistSyncer
NUXT_PUBLIC_PRO_PRICE=Configured at checkout
NUXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Logging: human-readable locally; set true for JSON severity logs
JSON_LOGGING=false

# Application security
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
SCHEDULER_SECRET=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/playlistsync
MONGODB_DATABASE=playlistsync

# Development only: comma-separated users granted effective PRO access
DEVELOPMENT_PRO_USER_EMAILS=

# Spotify Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google OAuth and YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login with Amazon and approved Amazon Music partner API
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_MUSIC_API_BASE_URL=

# Creem Billing
CREEM_API_KEY=
CREEM_PRO_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
CREEM_SERVER=test
